#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('portrussell-api:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port value into a number, string, or `false`.
 *
 * @param {string} val - Raw port value.
 * @returns {number|string|boolean} Parsed port, named pipe, or `false`.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    /**
     * Accept named pipe values.
     */
    return val;
  }

  if (port >= 0) {
    /**
     * Accept non-negative numeric ports.
     */
    return port;
  }

  return false;
}

/**
 * Handle HTTP server `error` events during startup.
 *
 * @param {NodeJS.ErrnoException} error - Startup error raised by Node.js HTTP server.
 * @returns {void} Exits process for known startup errors, otherwise rethrows.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  /**
   * Handle specific listen errors with friendly messages.
   */
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Handle HTTP server `listening` event.
 *
 * @returns {void} Logs the bound pipe or port through `debug`.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
